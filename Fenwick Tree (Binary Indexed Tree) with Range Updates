//Fenwick Tree (Binary Indexed Tree) with Range Updates
#include <iostream>
#include <vector>

using namespace std;

class FenwickRange {
    int n;
    vector<long long> bit1, bit2;

    void add(vector<long long>& bit, int idx, long long val) {
        for (; idx <= n; idx += idx & -idx) bit[idx] += val;
    }

    long long query(const vector<long long>& bit, int idx) {
        long long sum = 0;
        for (; idx > 0; idx -= idx & -idx) sum += bit[idx];
        return sum;
    }

    long long prefixSum(int idx) {
        return query(bit1, idx) * idx - query(bit2, idx);
    }

public:
    FenwickRange(int n) : n(n), bit1(n + 1, 0), bit2(n + 1, 0) {}

    void rangeUpdate(int l, int r, long long val) {
        add(bit1, l, val); add(bit1, r + 1, -val);
        add(bit2, l, val * (l - 1)); add(bit2, r + 1, -val * r);
    }

    long long rangeQuery(int l, int r) {
        return prefixSum(r) - prefixSum(l - 1);
    }
};

int main() {
    FenwickRange bit(5);
    bit.rangeUpdate(2, 4, 5);
    cout << "Range Query(1, 3): " << bit.rangeQuery(1, 3) << endl;
    return 0;
}
